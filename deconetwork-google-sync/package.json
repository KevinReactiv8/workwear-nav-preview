{
  "name": "deconetwork-google-sync",
  "version": "1.0.0",
  "description": "Extracts products from a DecoNetwork store and syncs them to Google Shopping (Merchant Center). Designed to run unattended every 24 hours.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "dn-google-sync": "./index.js"
  },
  "scripts": {
    "start": "node index.js",
    "sync": "node index.js",
    "test": "node --test"
  },
  "dependencies": {
    "@google-shopping/datasources": "^0.9.0",
    "@google-shopping/products": "^0.9.0",
    "google-auth-library": "^9.14.1"
  },
  "license": "MIT"
}
