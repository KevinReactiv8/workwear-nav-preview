# Copy to .env and fill in. Never commit the real .env.

# ---- DecoNetwork (source) ----
# Your store base URL, e.g. https://mystore.deconetwork.com
DECONETWORK_API_BASE=
# Account username + password (Enterprise plan / admin access required).
DECONETWORK_USERNAME=
DECONETWORK_PASSWORD=

# ---- Google Shopping (destination — Merchant API v1) ----
# Numeric Merchant Center account id.
GOOGLE_MERCHANT_ID=
# API-type data source id (create once in Merchant Center → Data sources).
GOOGLE_DATA_SOURCE_ID=
# Service-account key JSON. Paste the whole JSON on one line, OR use
# GOOGLE_SERVICE_ACCOUNT_FILE to point at a key file instead.
GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/service-account.json
GOOGLE_FEED_LABEL=GB
GOOGLE_CONTENT_LANGUAGE=en

# ---- Behaviour ----
# api | feed | both
SYNC_MODE=both
# true = don't write to Google (preview only)
DRY_RUN=false
# deconetwork | fixture  (fixture uses bundled sample data for demos/testing)
PRODUCT_SOURCE=deconetwork
CURRENCY=GBP
FEED_OUTPUT_PATH=output/google-shopping-feed.xml
LOG_LEVEL=info
# true = fail the run on any config/push problem instead of skipping gracefully
STRICT=false
